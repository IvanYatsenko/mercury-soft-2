{
  "name": "mercury-soft-2",
  "version": "3.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\" \"npm run dev:browser\"",
    "dev:api": "cd packages/api && npm run dev",
    "dev:client": "cd packages/client && npm run dev",
    "dev:browser": "cd packages/browser && npm run dev",
    "build": "npm run build --workspaces",
    "build:api": "cd packages/api && npm run build",
    "build:client": "cd packages/client && npm run build",
    "build:browser": "cd packages/browser && npm run build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-love": "^55.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
