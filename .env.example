# simulation — виртуальная плата, hardware — реальная плата через USB/Serial
MERCURY_CONTROLLER_MODE=simulation
MERCURY_SERIAL_PORT=auto
# Независимый предел испытаний. На симуляцию не влияет.
# В рабочей установке: 300; пороги термозащиты 285/300 задаются в настройках.
# Максимальная температура профиля остаётся 280 °C.
MERCURY_HARDWARE_MAX_TEMPERATURE_C=50
MERCURY_API_PORT=8075
# Совместимость со старой программой мониторинга: GET /status, только чтение.
MERCURY_MONITORING_PORT=3457
MERCURY_MONITORING_ENABLED=true
# На Raspberry: 0.0.0.0 — доступ к интерфейсу по IP из локальной сети.
MERCURY_API_HOST=127.0.0.1
# История и журнал: только смонтированный USB, без записи на SD при отказе.
MERCURY_LOG_USB_MOUNT=/media/flash
MERCURY_UPDATE_URL=https://www.nsc-com.com/soft/mercury
MERCURY_WEB_PORT=5173
# Необязательный абсолютный путь к базе; по умолчанию data/mercury.sqlite
# MERCURY_DATABASE_PATH=/home/pi/mercury-v3/data/mercury.sqlite
# Режим встроенного дисплея Raspberry Pi
MERCURY_PANEL_FULLSCREEN=false
MERCURY_PANEL_SOFTWARE_RENDERING=false

# Web Push is disabled until a trusted HTTPS origin and contact are configured.
# One stable HTTPS address per oven, without a path or query.
# MERCURY_PUBLIC_URL=https://oven.example:8443
# MERCURY_PUSH_SUBJECT=mailto:service@example.org
# Direct HTTPS on Raspberry (optional when using a local reverse proxy).
# Supply the real trusted certificate chain and its private key; no test certificates.
# MERCURY_HTTPS_PORT=8443
# MERCURY_TLS_CERT_PATH=/home/pi/.config/mercury-v3/tls/fullchain.pem
# MERCURY_TLS_KEY_PATH=/home/pi/.config/mercury-v3/tls/privkey.pem
